{"nodes": [{"id": "deploy_readme", "label": "Deploy README", "file_type": "document", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_readme_watcher_heartbeat_db", "label": "Watcher Heartbeat Stored in Database", "file_type": "rationale", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The watcher writes its heartbeat to the database (table core_watcher_heartbeat) instead of disk because the watcher and web server may run on separate machines without a shared filesystem (e.g. Railway worker + Render web). /healthz/watcher/ returns 503 if the heartbeat is missing or stale."}, {"id": "deploy_readme_render_railway_neon_topology", "label": "Render + Railway + Neon Free-Tier Deployment Topology", "file_type": "rationale", "source_file": "deploy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Free-tier topology for personal use: Render hosts the Gunicorn web app, Railway runs watch_tp_sl continuously as a worker, Neon provides pooled PostgreSQL. Both services must share identical security/DB environment variables; only the start command differs. DB_CONN_MAX_AGE=0 is kept because Neon suspends compute after inactivity."}], "edges": [{"source": "deploy_readme", "target": "apps_core_watcher_health", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deploy/README.md", "source_location": null, "weight": 1.0}, {"source": "deploy_readme", "target": "requirements", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deploy/README.md", "source_location": null, "weight": 1.0}, {"source": "deploy_readme", "target": "config_settings", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "s