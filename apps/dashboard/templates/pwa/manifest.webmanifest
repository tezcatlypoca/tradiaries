{% load static %}{
    "name": "Tradiaries",
    "short_name": "Tradiaries",
    "description": "Suivi d'investissements et de trading (spot, futures, analytics, journal).",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "background_color": "#080c10",
    "theme_color": "#10b981",
    "lang": "fr",
    "icons": [
        {
            "src": "{% static 'icons/candlestick-icon.svg' %}",
            "sizes": "any",
            "type": "image/svg+xml",
            "purpose": "any"
        },
        {
            "src": "{% static 'icons/candlestick-icon-192.png' %}",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "{% static 'icons/candlestick-icon-512.png' %}",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any maskable"
        }
    ]
}
